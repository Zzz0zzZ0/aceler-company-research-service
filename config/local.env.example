# Optional CRM connection: used by the read-only sampler or CRM enrichment.
# Enrichment --apply additionally needs company UPDATE permissions.
# Use one authoritative source for these variables; existing process values win.
TWENTY_DB_HOST=127.0.0.1
TWENTY_DB_PORT=5432
TWENTY_DB_NAME=twenty
TWENTY_DB_USER=readonly_user
TWENTY_DB_PASSWORD=
TWENTY_DB_SSLMODE=prefer
TWENTY_DB_CONNECT_TIMEOUT=5
TWENTY_WORKSPACE_SCHEMA=workspace_example

# Optional provider credentials. Leave blank when the installed adapters
# already receive them from the parent environment.
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
ANYSEARCH_API_KEY=

# Key pool is managed by scripts/crm-enrichment key-ui (never commit its JSON).
# CRM workers detect config/anysearch-keys.json automatically.
# Standalone CLI/API can opt in with an absolute ANYSEARCH_KEY_POOL_FILE path.

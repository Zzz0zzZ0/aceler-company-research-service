# Optional: only required for the read-only CRM sampler.
TWENTY_DB_HOST=127.0.0.1
TWENTY_DB_PORT=5432
TWENTY_DB_NAME=twenty
TWENTY_DB_USER=readonly_user
TWENTY_DB_PASSWORD=
TWENTY_DB_SSLMODE=prefer
TWENTY_DB_CONNECT_TIMEOUT=5
TWENTY_WORKSPACE_SCHEMA=workspace_example

# Optional provider credentials. Leave blank when the installed adapters
# already receive them from the parent environment.
MINIMAX_API_KEY=
MINIMAX_CN_API_KEY=
ANYSEARCH_API_KEY=
